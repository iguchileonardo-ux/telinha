{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telinha",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // Versão web (celular). O Worker roda antes dos arquivos porque a sinalização (WebSocket)
  // usa o endereço "/", o mesmo da página.
  "assets": { "directory": "./publico", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "Relay" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Relay"] }]
}
